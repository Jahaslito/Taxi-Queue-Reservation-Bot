# ─── SAN Queue — Production Environment ──────────────────────────────────────
# Copy this file to /opt/san-queue/.env on the droplet.
# Never commit the filled-in version to git.
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Database password (used by docker-compose to create the PG container) ────
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=GENERATE_64_CHAR_HEX
ENCRYPTION_KEY=GENERATE_DIFFERENT_64_CHAR_HEX
ADMIN_PASSWORD=CHANGE_THIS_STRONG_ADMIN_PASSWORD

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://your-domain.com

# ── Email (Resend — https://resend.com) ───────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=SAN Queue <noreply@your-domain.com>

# ── SAN URLs (copy from your existing .env) ───────────────────────────────────
MONITOR_QUEUE_URL=
MONITOR_T1_URL=
MONITOR_T2_URL=

# ── Proxy (optional but recommended — routes ALL SAN traffic through one IP) ──
# Supported: Bright Data, Smartproxy, Oxylabs (residential proxies work best).
# Used by BOTH the polling fetches (V Holding, T1, T2) AND the Playwright bot.
# Leave blank to use the droplet's own IP (fine for low driver counts).
#
# Bright Data example:
#   PROXY_SERVER=http://brd.superproxy.io:22225
#   PROXY_USERNAME=brd-customer-XXXXXXXX-zone-residential-session-{session}
#   PROXY_PASSWORD=your_bright_data_password
#
# Smartproxy example:
#   PROXY_SERVER=http://gate.smartproxy.com:10001
#   PROXY_USERNAME=user-XXXXXXXX-sessionid-{session}
#   PROXY_PASSWORD=your_smartproxy_password
#
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# ── Monitor tuning (leave blank to use defaults) ──────────────────────────────
MONITOR_POLL_MS=
MONITOR_REFRESH_MS=
MONITOR_CONCURRENCY=
MONITOR_START_HOUR=
MONITOR_END_HOUR=
MONITOR_POS_START_HOUR=
MONITOR_POS_END_HOUR=
MONITOR_MAX_TERMINAL_CHECKS=
