{
  "name": "san-edispatch-scheduler",
  "version": "1.0.0",
  "description": "Automated queue scheduler for SAN eDispatch",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "setup-browsers": "npx playwright install chromium --with-deps",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest tests/unit --runInBand --forceExit",
    "test:api": "jest tests/api --runInBand --forceExit",
    "test:services": "jest tests/services --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.2.10",
    "node-cron": "^3.0.3",
    "pg": "^8.20.0",
    "playwright": "^1.42.1",
    "resend": "^6.12.3",
    "stripe": "^22.1.1",
    "undici": "^8.3.0"
  },
  "devDependencies": {
    "better-sqlite3": "^12.10.0",
    "jest": "^29.7.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "supertest": "^7.0.0"
  }
}
